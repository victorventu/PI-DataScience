#!/bin/bash
# -----------------------------------------------------------------------------
# pipeline.sh - Executa o simulador e envia os dados para a vm-bigdata
# -----------------------------------------------------------------------------

# 1. Gera novos dados de vendas localmente
python3 /opt/fca/simulator/gerador_vendas.py --saida /opt/fca/data/raw/vendas.csv

# 2. Envia os dados crus para a vm-bigdata via SCP
scp -o StrictHostKeyChecking=no /opt/fca/data/raw/vendas.csv aluno@192.168.122.37:/opt/fca/data/raw/vendas.csv

echo "[$(date)] Pipeline executado com sucesso e dados enviados para a vm-bigdata."
